# Copy this file to `.env` and fill in your own keys.
# Never commit the real .env to git.

ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENAI_API_KEY=your_hackclub_or_openai_api_key

# Optional overrides
OPENAI_URL=https://ai.hackclub.com/proxy/v1/chat/completions
LLM_MODEL=google/gemini-2.5-flash
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # George - warm British narrator
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
CHARACTER_NAMES=shrit, raj, punit, shreyas
BG_MUSIC_PATH=bg.mp3
